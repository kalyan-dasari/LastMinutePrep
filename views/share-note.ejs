<%- include('partials/header') %>

<section class="panel">
  <h1>Share Note</h1>
  <p class="panel-subtitle">Copy the link below to share this note directly with friends or study groups.</p>

  <div class="share-box">
    <input type="text" id="shareUrl" value="<%= shareUrl %>" readonly />
    <button class="btn-primary" onclick="copyShareUrl()">Copy Link</button>
  </div>

  <div class="note-preview">
    <h3><%= note.title %></h3>
    <p>By <%= note.contributor_name %></p>
  </div>
</section>

<%- include('partials/footer') %>
